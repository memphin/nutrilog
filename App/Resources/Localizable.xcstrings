    "Maintenance comes to %@, below %@, the lowest target the app suggests." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Maintenance comes to %1$@, below %2$@, the lowest target the app suggests."
