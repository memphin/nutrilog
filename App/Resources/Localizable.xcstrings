    "Estimated maintenance %@ = %@ (rounded to 10 kcal)." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Estimated maintenance %1$@ = %2$@ (rounded to 10 kcal)."
