          }
        }
      }
    },
    "Nothing is written to Apple Health; samples written earlier stay there, and entries you change now keep their old values in Health. When you turn this back on, new changes are written again and samples of entries deleted meanwhile are removed." : {
      "localizations" : {
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ništa se ne zapisuje u aplikaciju Zdravlje; ranije zapisani uzorci ostaju ondje, a unosi koje sada promijeniš zadržavaju stare vrijednosti u aplikaciji Zdravlje. Kad ovo ponovno uključiš, nove promjene opet se zapisuju, a uzorci unosa obrisanih u međuvremenu uklanjaju se."
          }
        }
      }
    },
