    "%@ isn't a product barcode (EAN / UPC). Try another code." : {
      "localizations" : {
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ nije barkod proizvoda (EAN / UPC). Pokušaj s drugim kodom."
          }
        }
      }
    },
    "%@ isn't in your foods or on Open Food Facts. Create it from the label: next time this barcode is scanned it is found instantly, even offline." : {
      "localizations" : {
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ nije među tvojim namirnicama ni na Open Food Facts. Napravi namirnicu prema deklaraciji: kad se ovaj barkod sljedeći put skenira, odmah će se pronaći, čak i bez interneta."
          }
        }
      }
    },
