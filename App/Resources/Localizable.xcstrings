    "%@ is busy. Try again in a minute." : {
      "localizations" : {
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usluga %@ trenutačno je zauzeta. Pokušaj ponovno za minutu."
          }
        }
      }
    },
    "%@ is less than half of your estimated %@ a day. If something is missing, add it. If this really was everything, mark the day as fully logged." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ is less than half of your estimated %2$@ a day. If something is missing, add it. If this really was everything, mark the day as fully logged."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ je manje od pola tvoje procijenjene dnevne potrošnje od %2$@. Ako nešto nedostaje, dodaj to. Ako je to stvarno bilo sve, označi dan kao potpuno zapisan."
          }
        }
      }
    },
    "%@ is no longer available." : {
      "localizations" : {
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
