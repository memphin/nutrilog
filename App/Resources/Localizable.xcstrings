    "High: at least %lld days of history with 80 %% of them logged, and a weight trend at least %lld days old with weigh-ins on at least %lld of the last %lld days." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "High: at least %1$lld days of history with 80 %% of them logged, and a weight trend at least %2$lld days old with weigh-ins on at least %3$lld of the last %4$lld days."
          }
        },
        "hr" : {
          "stringUnit" : {
