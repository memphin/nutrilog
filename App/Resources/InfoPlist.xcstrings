    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Vitalion uses the camera to scan product barcodes and to take a photo of a meal to estimate what it contains."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vitalion koristi kameru za skeniranje barkodova proizvoda i za fotografiranje obroka kako bi procijenio što sadrži."
          }
        }
      }
    },
    "NSHealthShareUsageDescription" : {
      "comment" : "Privacy - Health Share Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Vitalion reads your weight, body fat, steps, sleep, energy, heart rate, water and workouts from Apple Health to show them next to what you eat."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vitalion čita tvoju težinu, tjelesnu mast, korake, san, energiju, puls, vodu i treninge iz aplikacije Zdravlje kako bi ih prikazao uz ono što jedeš."
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription" : {
      "comment" : "Privacy - Health Update Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Vitalion writes the nutrients and water you log, and the weight and body fat you enter manually, to Apple Health."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vitalion u aplikaciju Zdravlje zapisuje nutrijente i vodu koje zapišeš te težinu i tjelesnu mast koje ručno uneseš."
          }
        }
      }
    }
  },
  "version" : "1.0"
