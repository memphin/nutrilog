    "Your weight history is too short. Keep weighing in for about a week." : {
      "localizations" : {
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvoja povijest težine prekratka je. Nastavi se vagati još otprilike tjedan dana."
          }
        }
      }
    },
    "Your weight trend is still young or your weigh-ins are sparse, so the change is measured with a straight line through this window's weigh-ins instead." : {
      "localizations" : {
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvoj trend težine još je mlad ili su ti vaganja rijetka, pa se promjena umjesto toga mjeri ravnom linijom kroz vaganja u ovom razdoblju."
          }
        }
      }
    }
