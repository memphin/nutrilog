{
  "sourceLanguage" : "en",
  "strings" : {
    "A barcode has 8, 12, 13 or 14 digits." : {
      "localizations" : {
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Barkod ima 8, 12, 13 ili 14 znamenki."
          }
        }
      }
    },
    "Barcode digits" : {
      "localizations" : {
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Znamenke barkoda"
          }
        }
      }
    },
    "Camera Access Off" : {
      "localizations" : {
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pristup kameri isključen"
          }
        }
