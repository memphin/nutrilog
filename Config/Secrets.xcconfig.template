// Copy to Config/Secrets.xcconfig (git-ignored). Values are exposed to the app via Info.plist keys.
// Note: "//" starts a comment in .xcconfig files, so URLs are written as https:/$()/host/...

// Optional. Leave empty to rely on the in-app Settings key (Keychain) or bundled data only.
USDA_FDC_API_KEY =

// Shown in the User-Agent header sent to Open Food Facts.
OFF_USER_AGENT_CONTACT = https:/$()/github.com/memphin/vitalion

// Your Apple Developer Team ID (Xcode → Settings → Accounts). Needed only for device builds.
DEVELOPMENT_TEAM =
